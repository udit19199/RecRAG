# Python
__pycache__/
*.py[cod]
*$py.class
*.so
# Root only: run folders keep a build/ directory of index-build records
/build/
dist/
wheels/
*.egg-info/
*.egg
.ruff_cache/

# Virtual environments
.venv/
.venv-hipporag/
venv/
ENV/

# Environment
.env
.env.local

# Streamlit
.streamlit/secrets.toml

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Experiment outputs: run results are committed; indexes and caches are
# rebuildable and too large, so they stay local
results/
runs/**/indexes/
runs/**/construction-cache/
runs/hf-cache/
runs/hipporag-cache/
runs/**/*.sqlite*
runs/**/*.parquet
runs/**/*.pickle
state/
tmp/

# Index-build records are committed (build.json, errors, purged rows); the
# verbose log and itemised per-call cost dumps are too large and stay local.
# The ! line overrides the global gitignore's broad "build/" rule.
!runs/**/build/
runs/**/build/build.log
runs/**/build/build_cost*.json

# Dataset inputs are fetched on demand by dataset.py and scripts/. The pinned
# HotpotQA sample is committed because it fixes the question set.
datasets/*
!datasets/hotpotqa/
datasets/hotpotqa/*
!datasets/hotpotqa/hotpotqa_distractor_validation_hard_bridge_1000_seed_42.json

# Agent and local tooling
.agents/
.claude/
.codex/
.cursor/
.gemini/
skills-lock.json
