{"id": "b002b59444e3d1fd", "facts": [
{"fact": "0.0", "status": "stated", "evidence": [{"item": 12, "quote": "Because the states were preexisting political entities , the U.S. Constitution did not need to define or explain federalism in any one section"}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 12, "quote": "the U.S. Constitution did not need to define or explain federalism in any one section but it often mentions the rights and responsibilities of state governments and state officials in relation to the federal government"}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 12, "quote": "The federal government has certain express powers ( also called enumerated powers ) which are powers spelled out in the Constitution"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 12, "quote": "including the right to levy taxes , declare war , and regulate interstate and foreign commerce"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 5, "quote": "In addition , the Necessary and Proper Clause gives the federal government the implied power to pass any law `` necessary and proper '' for the execution of its express powers"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 5, "quote": "Other powers -- the reserved powers -- are reserved to the people or the states"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 5, "quote": "The power delegated to the federal government was significantly expanded by the Supreme Court decision in McCulloch v. Maryland ( 1819 )"}]},
{"fact": "0.7", "status": "contradicted", "evidence": [{"item": 19, "quote": "The federal government acquired no substantial new powers until the acceptance by the Supreme Court of the Sherman Anti-Trust Act"}]},
{"fact": "0.8", "status": "contradicted", "evidence": [{"item": 19, "quote": "The federal government acquired no substantial new powers until the acceptance by the Supreme Court of the Sherman Anti-Trust Act"}]},
{"fact": "0.9", "status": "stated", "evidence": [{"item": 5, "quote": "the overall claim of the Civil War , that the states were legally subject to the final dictates of the federal government"}]}
]}
]
