{"id": "a8b8bb1a49d25360", "facts": [
{"fact": "0.0", "status": "stated", "evidence": [{"item": 5, "quote": "Because the states were preexisting political entities , the U.S. Constitution did not need to define or explain federalism in any one section"}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 5, "quote": "it often mentions the rights and responsibilities of state governments and state officials in relation to the federal government"}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 5, "quote": "The federal government has certain express powers ( also called enumerated powers ) which are powers spelled out in the Constitution"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 5, "quote": "including the right to levy taxes , declare war , and regulate interstate and foreign commerce"}]},
{"fact": "0.4", "status": "missing", "evidence": []},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 3, "quote": "which reserves all powers and rights that are not delegated to the Federal Government as left to the States and to the people"}]},
{"fact": "0.6", "status": "missing", "evidence": []},
{"fact": "0.7", "status": "missing", "evidence": []},
{"fact": "0.8", "status": "missing", "evidence": []},
{"fact": "0.9", "status": "missing", "evidence": []}
