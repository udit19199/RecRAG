{"fact": "1.0", "status": "stated", "evidence": [{"item": 7, "quote": "Fortnite was first revealed at the 2011 Spike Video Game Awards ( VGA )"}]},
{"fact": "1.1", "status": "stated", "evidence": [{"item": 7, "quote": "with Epic 's former design director Cliff Bleszinski introducing a trailer for the game"}]},
{"fact": "1.2", "status": "stated", "evidence": [{"item": 7, "quote": "Donald Mustard , creative lead at Epic , said in 2017 that this announcement was `` three weeks after we came up with the idea , before we even made the game ''"}]},
{"fact": "1.3", "status": "stated", "evidence": [{"item": 7, "quote": "Donald Mustard , creative lead at Epic , said in 2017 that this announcement was `` three weeks after we came up with the idea , before we even made the game ''"}]},
{"fact": "1.4", "status": "stated", "evidence": [{"item": 7, "quote": "The title , which started out as an internal game jam project , represents a departure from the company 's previous work"}]},
{"fact": "1.5", "status": "stated", "evidence": [{"item": 7, "quote": "The title , which started out as an internal game jam project , represents a departure from the company 's previous work"}]},
{"fact": "1.6", "status": "stated", "evidence": [{"item": 7, "quote": "Bleszinski explained during the Spike event , Epic wanted to `` switch things up a little bit and do something different and fun '' with Fortnite"}]},
{"fact": "1.7", "status": "stated", "evidence": [{"item": 7, "quote": "it as `` a world where you explore , you scavenge , you build and ultimately you survive . ''"}]},
{"fact": "1.8", "status": "stated", "evidence": [{"item": 7, "quote": "In an interview with Engadget , he also echoed these statements"}]},
{"fact": "1.9", "status": "stated", "evidence": [{"item": 7, "quote": "claiming that the game would be different from the Gears of War series"}]},
{"fact": "1.10", "status": "stated", "evidence": [{"item": 7, "quote": "There 's no dudebros in it"}]},
{"fact": "1.11", "status": "stated", "evidence": [{"item": 7, "quote": "But creatively for the team , Gears has been amazing for us"}]},
{"fact": "1.12", "status": "stated", "evidence": [{"item": 7, "quote": "But it 's fun to kind of stretch our wings and do something that 's a little different from the usual"}]},
{"fact": "1.13", "status": "stated", "evidence": [{"item": 6, "quote": "Epic Games Vice President of Publishing Mike Fischer said in 2015 that Epic recognized that they `` announced this game too soon ''"}]},
{"fact": "1.14", "status": "stated", "evidence": [{"item": 6, "quote": "and that its lengthy development period was due to `` very good reasons . ''"}]}
]},
