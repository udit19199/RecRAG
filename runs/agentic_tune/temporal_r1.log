Received notification from DBMS server: <GqlStatusObject gql_status='01N00', status_description='warn: feature deprecated. CALL subquery without a variable scope clause is deprecated. Use CALL (a) { ... }', position=<SummaryInputPosition line=11, column=1, offset=449>, raw_classification='DEPRECATION', classification=<NotificationClassification.DEPRECATION: 'DEPRECATION'>, raw_severity='WARNING', severity=<NotificationSeverity.WARNING: 'WARNING'>, diagnostic_record={'_classification': 'DEPRECATION', '_severity': 'WARNING', '_position': {'offset': 449, 'line': 11, 'column': 1}, 'OPERATION': '', 'OPERATION_CODE': '0', 'CURRENT_SCHEMA': '/'}> for query: "EXPLAIN MATCH (a:Article)-[:PUBLISHED_BY]->(p)\nWHERE (\n  toLower(p.name) CONTAINS 'techcrunch' OR\n  any(alias IN coalesce(p.aliases, []) WHERE toLower(alias) CONTAINS 'techcrunch')\n)\nAND (\n  (a.published_on = '2023-10-31' AND toLower(a.name) CONTAINS '5 things we learned so far about the google antitrust case')\n  OR\n  (a.published_on = '2023-12-15' AND toLower(a.name) CONTAINS 'news publisher files class action antitrust suit against google')\n)\nCALL {\n  WITH a\n  OPTIONAL MATCH (a)-[r:MENTIONS|SAID|PARTICIPATED_IN|PART_OF]->(e:__Entity__)\n  RETURN collect(DISTINCT CASE WHEN e IS NOT NULL THEN {entity: e.name, relationship: type(r)} END) AS connections\n}\nCALL {\n  WITH a\n  OPTIONAL MATCH (a)-[:MENTIONS]->(g:Organization)-[:ACCUSED_OF]->(x:__Entity__)\n  WHERE toLower(g.name) CONTAINS 'google'\n     OR any(alias IN coalesce(g.aliases, []) WHERE toLower(alias) CONTAINS 'google')\n  RETURN collect(DISTINCT x.name) AS reported_allegations\n}\nCALL {\n  WITH a\n  OPTIONAL MATCH (a)-[:FROM_CHUNK]->(c:Chunk)\n  RETURN collect(DISTINCT c.text) AS passages\n}\nRETURN a.name AS article, a.published_on AS published_on, p.name AS publisher,\n       connections, reported_allegations, passages\nLIMIT 10"
