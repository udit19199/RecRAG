Received notification from DBMS server: <GqlStatusObject gql_status='01N00', status_description='warn: feature deprecated. CALL subquery without a variable scope clause is deprecated. Use CALL (vg) { ... }', position=<SummaryInputPosition line=27, column=1, offset=1331>, raw_classification='DEPRECATION', classification=<NotificationClassification.DEPRECATION: 'DEPRECATION'>, raw_severity='WARNING', severity=<NotificationSeverity.WARNING: 'WARNING'>, diagnostic_record={'_classification': 'DEPRECATION', '_severity': 'WARNING', '_position': {'offset': 1331, 'line': 27, 'column': 1}, 'OPERATION': '', 'OPERATION_CODE': '0', 'CURRENT_SCHEMA': '/'}> for query: "EXPLAIN MATCH (tc:Article)-[:PUBLISHED_BY]->(tp),\n      (vg:Article)-[:PUBLISHED_BY]->(vp)\nWHERE (toLower(tp.name) CONTAINS 'techcrunch' OR any(alias IN coalesce(tp.aliases, []) WHERE toLower(alias) CONTAINS 'techcrunch'))\n  AND (toLower(vp.name) CONTAINS 'the verge' OR any(alias IN coalesce(vp.aliases, []) WHERE toLower(alias) CONTAINS 'the verge'))\n  AND (toLower(coalesce(tc.published_on, '')) CONTAINS '2023-12-15' OR toLower(coalesce(tc.published_on, '')) CONTAINS 'december 15, 2023')\n  AND (toLower(coalesce(vg.published_on, '')) CONTAINS '2023-09-26' OR toLower(coalesce(vg.published_on, '')) CONTAINS 'september 26, 2023')\n  AND toLower(tc.name) CONTAINS 'google'\n  AND (toLower(vg.name) CONTAINS 'apple' AND toLower(vg.name) CONTAINS 'search')\nOPTIONAL MATCH (tc)-[:MENTIONS]->(g:__Entity__)<-[:MENTIONS]-(vg)\nWHERE toLower(g.name) CONTAINS 'google'\n   OR any(alias IN coalesce(g.aliases, []) WHERE toLower(alias) CONTAINS 'google')\nCALL {\n  WITH tc\n  OPTIONAL MATCH (tc)-[:FROM_CHUNK]->(c:Chunk)\n  RETURN collect(DISTINCT c.text)[0..5] AS techcrunch_passages\n}\nCALL {\n  WITH vg\n  OPTIONAL MATCH (vg)-[:FROM_CHUNK]->(c:Chunk)\n  RETURN collect(DISTINCT c.text)[0..5] AS verge_passages\n}\nCALL {\n  WITH tc\n  OPTIONAL MATCH (tc)-[:MENTIONS]->(e:__Entity__)\n  RETURN collect(DISTINCT e.name)[0..10] AS techcrunch_entities\n}\nCALL {\n  WITH vg\n  OPTIONAL MATCH (vg)-[:MENTIONS]->(e:__Entity__)\n  RETURN collect(DISTINCT e.name)[0..10] AS verge_entities\n}\nRETURN tc.name AS techcrunch_article, tc.published_on AS techcrunch_date,\n       tp.name AS techcrunch_publisher, techcrunch_entities, techcrunch_passages,\n       vg.name AS verge_article, vg.published_on AS verge_date,\n       vp.name AS verge_publisher, verge_entities, verge_passages,\n       collect(DISTINCT g.name) AS shared_google_entities\nLIMIT 10"
