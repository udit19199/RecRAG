 reuters_passages\n}\nCALL {\n  WITH ba\n  OPTIONAL MATCH (ba)-[:MENTIONS]->(be:__Entity__)\n  RETURN collect(DISTINCT {name: be.name, aliases: be.aliases}) AS bloomberg_entities\n}\nCALL {\n  WITH ra\n  OPTIONAL MATCH (ra)-[:MENTIONS]->(re:__Entity__)\n  RETURN collect(DISTINCT {name: re.name, aliases: re.aliases}) AS reuters_entities\n}\nRETURN bp.name AS bloomberg_publisher, ba.name AS bloomberg_article,\n       ba.published_on AS bloomberg_date, bloomberg_passages, bloomberg_entities,\n       rp.name AS reuters_publisher, ra.name AS reuters_article,\n       ra.published_on AS reuters_date, reuters_passages, reuters_entities,\n       visa.name AS visa_entity, visa.aliases AS visa_aliases\nLIMIT 10"
