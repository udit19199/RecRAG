Received notification from DBMS server: <GqlStatusObject gql_status='01N00', status_description='warn: feature deprecated. CALL subquery without a variable scope clause is deprecated. Use CALL (p) { ... }', position=<SummaryInputPosition line=4, column=1, offset=160>, raw_classification='DEPRECATION', classification=<NotificationClassification.DEPRECATION: 'DEPRECATION'>, raw_severity='WARNING', severity=<NotificationSeverity.WARNING: 'WARNING'>, diagnostic_record={'_classification': 'DEPRECATION', '_severity': 'WARNING', '_position': {'offset': 160, 'line': 4, 'column': 1}, 'OPERATION': '', 'OPERATION_CODE': '0', 'CURRENT_SCHEMA': '/'}> for query: "EXPLAIN MATCH (p:Person)\nWHERE toLower(p.name) CONTAINS 'asha shobana'\n   OR any(alias IN coalesce(p.aliases, []) WHERE toLower(alias) CONTAINS 'asha shobana')\nCALL {\n  WITH p\n  MATCH (a:Article)-[:MENTIONS]-(p)\n        -[:PUBLISHED_BY]-(pub:Publisher|Organization)\n  WHERE toLower(pub.name) CONTAINS 'the times of india'\n     OR any(alias IN coalesce(pub.aliases, []) WHERE toLower(alias) CONTAINS 'the times of india')\n     OR toLower(pub.name) CONTAINS 'the hindu'\n     OR any(alias IN coalesce(pub.aliases, []) WHERE toLower(alias) CONTAINS 'the hindu')\n  RETURN 'article' AS connection, a.name AS item, pub.name AS source,\n         a.published_on AS date, null AS location\n  UNION ALL\n  WITH p\n  MATCH (p)-[:PARTICIPATED_IN|MENTIONS]-(e:Event)\n  OPTIONAL MATCH (e)-[:LOCATED_IN]-(place:Place)\n  WHERE toLower(e.name) CONTAINS 'award'\n     OR toLower(e.name) CONTAINS 'dance'\n     OR toLower(e.name) CONTAINS 'workshop'\n     OR toLower(e.name) CONTAINS 'recital'\n     OR toLower(place.name) CONTAINS 'chennai'\n     OR toLower(place.name) CONTAINS 'bangalore'\n     OR any(alias IN coalesce(place.aliases, []) WHERE toLower(alias) CONTAINS 'chennai' OR toLower(alias) CONTAINS 'bangalore')\n  RETURN 'event' AS connection, e.name AS item, null AS source,\n         e.held_on AS date, place.name AS location\n}\nRETURN connection, item, source, date, location\nLIMIT 10"
