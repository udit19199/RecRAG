Received notification from DBMS server: <GqlStatusObject gql_status='01N00', status_description='warn: feature deprecated. CALL subquery without a variable scope clause is deprecated. Use CALL (person) { ... }', position=<SummaryInputPosition line=4, column=1, offset=181>, raw_classification='DEPRECATION', classification=<NotificationClassification.DEPRECATION: 'DEPRECATION'>, raw_severity='WARNING', severity=<NotificationSeverity.WARNING: 'WARNING'>, diagnostic_record={'_classification': 'DEPRECATION', '_severity': 'WARNING', '_position': {'offset': 181, 'line': 4, 'column': 1}, 'OPERATION': '', 'OPERATION_CODE': '0', 'CURRENT_SCHEMA': '/'}> for query: "EXPLAIN MATCH (person:Person)\nWHERE toLower(person.name) CONTAINS 'shreyanka patil'\n   OR any(alias IN coalesce(person.aliases, []) WHERE toLower(alias) CONTAINS 'shreyanka patil')\nCALL {\n  WITH person\n  MATCH (person)-[:PARTICIPATED_IN]->(event:Event)\n  OPTIONAL MATCH (team:Organization)-[:PARTICIPATED_IN]->(event)\n  WITH event, collect(DISTINCT team.name) AS teams\n  ORDER BY event.held_on DESC\n  LIMIT 1\n  RETURN event, teams\n}\nMATCH (article:Article)-[:PUBLISHED_BY]->(publisher:__Entity__)\nMATCH (article)-[:MENTIONS]->(person)\nWHERE toLower(publisher.name) CONTAINS 'the times of india'\n   OR toLower(publisher.name) CONTAINS 'the hindu'\n   OR any(alias IN coalesce(publisher.aliases, []) WHERE toLower(alias) CONTAINS 'the times of india' OR toLower(alias) CONTAINS 'the hindu')\nRETURN DISTINCT article.name AS article_title, article.published_on AS published_on, event.name AS most_recent_match, event.held_on AS match_date, teams AS teams, event.score AS match_result_or_score\nLIMIT 10"
