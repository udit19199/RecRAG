NTAINS 'trial' OR toLower(alias) CONTAINS 'public')\nRETURN DISTINCT o.name AS organization,\n       hq.name AS headquarters_city,\n       pub.name AS publisher,\n       a.name AS article,\n       a.published_on AS published_on,\n       fact.name AS related_fact,\n       labels(fact) AS fact_type,\n       COALESCE(trial.name, articleTrial.name) AS trial_event,\n       COALESCE(trialCity.name, articleTrialCity.name) AS trial_city\nLIMIT 10"
