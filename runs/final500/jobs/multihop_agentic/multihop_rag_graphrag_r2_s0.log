Received notification from DBMS server: <GqlStatusObject gql_status='01N00', status_description='warn: feature deprecated. CALL subquery without a variable scope clause is deprecated. Use CALL (a) { ... }', position=<SummaryInputPosition line=9, column=1, offset=491>, raw_classification='DEPRECATION', classification=<NotificationClassification.DEPRECATION: 'DEPRECATION'>, raw_severity='WARNING', severity=<NotificationSeverity.WARNING: 'WARNING'>, diagnostic_record={'_classification': 'DEPRECATION', '_severity': 'WARNING', '_position': {'offset': 491, 'line': 9, 'column': 1}, 'OPERATION': '', 'OPERATION_CODE': '0', 'CURRENT_SCHEMA': '/'}> for query: "EXPLAIN MATCH (a:Article)\nWHERE (\n  toLower(a.name) CONTAINS 'apple defends google search deal in court'\n  OR any(alias IN coalesce(a.aliases, []) WHERE toLower(alias) CONTAINS 'apple defends google search deal in court')\n  OR toLower(a.name) CONTAINS '5 things we learned so far about the google antitrust case'\n  OR any(alias IN coalesce(a.aliases, []) WHERE toLower(alias) CONTAINS '5 things we learned so far about the google antitrust case')\n)\nOPTIONAL MATCH (a)-[:PUBLISHED_BY]->(pub)\nCALL {\n  WITH a\n  OPTIONAL MATCH (a)-[:MENTIONS]->(person:Person)\n  RETURN collect(DISTINCT person.name) AS people_mentioned\n}\nCALL {\n  WITH pub\n  OPTIONAL MATCH (author:Person)-[:WORKS_FOR]->(pub)\n  RETURN collect(DISTINCT author.name) AS publisher_affiliated_people\n}\nCALL {\n  MATCH (g:Organization)-[r]-(x:__Entity__)\n  WHERE (toLower(g.name) CONTAINS 'google'\n      OR any(alias IN coalesce(g.aliases, []) WHERE toLower(alias) CONTAINS 'google'))\n    AND (toLower(coalesce(x.name, '')) CONTAINS 'search'\n      OR toLower(coalesce(x.name, '')) CONTAINS 'default'\n      OR r.amount IS NOT NULL\n      OR r.stake IS NOT NULL)\n  RETURN collect(DISTINCT {\n    relationship: type(r),\n    related: x.name,\n    amount: r.amount,\n    stake: r.stake\n  }) AS google_search_spending_connections\n}\nRETURN a.name AS article,\n       pub.name AS publisher,\n       people_mentioned,\n       publisher_affiliated_people,\n       google_search_spending_connections\nLIMIT 10"
