\n  any(t IN texts WHERE t CONTAINS 'google search' AND t CONTAINS 'better' AND t CONTAINS 'fair')\n  AND EXISTS {\n    MATCH (a)-[:PUBLISHED_BY]->(pub)\n    WHERE (pub:`Publisher OR pub`:Organization)\n      AND (toLower(pub.name) CONTAINS 'the age' OR any(alias IN coalesce(pub.aliases, []) WHERE toLower(alias) CONTAINS 'the age'))\n  }\n)\nOPTIONAL MATCH (a)-[:PUBLISHED_BY]->(pub)\nOPTIONAL MATCH (a)-[r:MENTIONS|SAID|PARTICIPATED_IN|PART_OF]->(e)\nRETURN a.name AS article, a.published_on AS published_on, pub.name AS publisher,\n       type(r) AS relationship, e.name AS connected_entity, labels(e) AS entity_types\nLIMIT 10"
