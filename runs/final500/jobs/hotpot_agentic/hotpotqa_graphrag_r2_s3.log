Received notification from DBMS server: <GqlStatusObject gql_status='01N00', status_description='warn: feature deprecated. CALL subquery without a variable scope clause is deprecated. Use CALL (f1) { ... }', position=<SummaryInputPosition line=5, column=1, offset=351>, raw_classification='DEPRECATION', classification=<NotificationClassification.DEPRECATION: 'DEPRECATION'>, raw_severity='WARNING', severity=<NotificationSeverity.WARNING: 'WARNING'>, diagnostic_record={'_classification': 'DEPRECATION', '_severity': 'WARNING', '_position': {'offset': 351, 'line': 5, 'column': 1}, 'OPERATION': '', 'OPERATION_CODE': '0', 'CURRENT_SCHEMA': '/'}> for query: "EXPLAIN MATCH (f1:CreativeWork:__Entity__), (f2:CreativeWork:__Entity__)\nWHERE (toLower(f1.name) CONTAINS 'the bears and i' OR any(alias IN coalesce(f1.aliases, []) WHERE toLower(alias) CONTAINS 'the bears and i'))\n  AND (toLower(f2.name) CONTAINS 'oceans' OR any(alias IN coalesce(f2.aliases, []) WHERE toLower(alias) CONTAINS 'oceans'))\nWITH f1, f2\nCALL {\n  WITH f1\n  OPTIONAL MATCH (f1)-[r]-(x:__Entity__)\n  RETURN collect(DISTINCT CASE WHEN r IS NULL THEN null ELSE {relationship: type(r), related: x.name} END) AS facts1\n}\nCALL {\n  WITH f2\n  OPTIONAL MATCH (f2)-[r]-(x:__Entity__)\n  RETURN collect(DISTINCT CASE WHEN r IS NULL THEN null ELSE {relationship: type(r), related: x.name} END) AS facts2\n}\nCALL {\n  WITH f1, f2\n  OPTIONAL MATCH (mid:CreativeWork:__Entity__)\n  WHERE mid <> f1 AND mid <> f2\n    AND f1.published_on IS NOT NULL AND f2.published_on IS NOT NULL\n    AND mid.published_on IS NOT NULL\n    AND mid.published_on > CASE WHEN f1.published_on < f2.published_on THEN f1.published_on ELSE f2.published_on END\n    AND mid.published_on < CASE WHEN f1.published_on > f2.published_on THEN f1.published_on ELSE f2.published_on END\n  RETURN collect(DISTINCT CASE WHEN mid IS NULL THEN null ELSE {film: mid.name, release_date: mid.published_on} END) AS films_between\n}\nRETURN f1.name AS film, f1.published_on AS release_date, facts1 AS connected_facts,\n       f2.name AS other_film, f2.published_on AS other_release_date, facts2 AS other_connected_facts,\n       films_between\nLIMIT 10"
