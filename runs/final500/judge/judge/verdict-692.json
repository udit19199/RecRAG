{"fact": "0.5", "status": "stated", "evidence": [{"item": 4, "quote": "Since smaller - appearing objects seem farther away than they actually are"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 4, "quote": "a driver might make a maneuver such as a lane change assuming an adjacent vehicle is a safe distance behind"}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 4, "quote": "when in fact it is quite a bit closer"}]},
{"fact": "0.8", "status": "stated", "evidence": [{"item": 4, "quote": "The warning serves as a reminder to the driver of this potential problem"}]}
]},
