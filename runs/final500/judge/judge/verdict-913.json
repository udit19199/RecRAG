{"fact": "0.0", "status": "stated", "evidence": [{"item": 9, "quote": "The Ring of Fire is a direct result of plate tectonics : the movement and collisions of lithospheric plates ."}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 9, "quote": "The Ring of Fire is a direct result of plate tectonics : the movement and collisions of lithospheric plates ."}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 9, "quote": "eastern section of the ring is the result of the Nazca Plate and the Cocos Plate being subducted beneath the westward - moving South American Plate ."}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 9, "quote": "eastern section of the ring is the result of the Nazca Plate and the Cocos Plate being subducted beneath the westward - moving South American Plate ."}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 9, "quote": "The Cocos Plate is being subducted beneath the Caribbean Plate , in Central America ."}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 9, "quote": "A portion of the Pacific Plate and the small Juan de Fuca Plate are being subducted beneath the North American Plate ."}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 9, "quote": "A portion of the Pacific Plate and the small Juan de Fuca Plate are being subducted beneath the North American Plate ."}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 9, "quote": "Along the northern portion , the northwestward - moving Pacific plate is being subducted beneath the Aleutian Islands arc ."}]},
{"fact": "0.8", "status": "stated", "evidence": [{"item": 9, "quote": "Farther west , the Pacific plate is being subducted along the Kamchatka Peninsula arcs on south past Japan ."}]},
{"fact": "0.9", "status": "stated", "evidence": [{"item": 1, "quote": "The southern portion is more complex"}]},
{"fact": "0.10", "status": "stated", "evidence": [{"item": 1, "quote": "The southern portion is more complex , with a number of smaller tectonic plates in collision with the Pacific plate from the Mariana Islands , the Philippines , Bougainville , Tonga , and New Zealand"}]},
{"fact": "0.11", "status": "stated", "evidence": [{"item": 1, "quote": "this portion excludes Australia , since it lies in the center of its tectonic plate ."}]},
{"fact": "0.12", "status": "stated", "evidence": [{"item": 1, "quote": "this portion excludes Australia , since it lies in the center of its tectonic plate ."}]},
{"fact": "0.13", "status": "stated", "evidence": [{"item": 1, "quote": "Indonesia lies between the Ring of Fire along the northeastern islands adjacent to and including New Guinea and the Alpide belt"}]},
{"fact": "0.14", "status": "stated", "evidence": [{"item": 1, "quote": "the Alpide belt along the south and west from Sumatra , Java , Bali , Flores , and Timor"}]},
{"fact": "0.15", "status": "stated", "evidence": [{"item": 1, "quote": "The famous and very active San Andreas Fault zone of California"}]},
{"fact": "0.16", "status": "stated", "evidence": [{"item": 1, "quote": "San Andreas Fault zone of California is a transform fault"}]},
{"fact": "0.17", "status": "stated", "evidence": [{"item": 1, "quote": "The famous and very active San Andreas Fault zone of California is a transform fault which offsets a portion of the East Pacific Rise under southwestern United States and Mexico ."}]},
{"fact": "0.18", "status": "stated", "evidence": [{"item": 1, "quote": "The famous and very active San Andreas Fault zone of California is a transform fault which offsets a portion of the East Pacific Rise under southwestern United States and Mexico . The motion of the fault generates numerous small earthquakes , at multiple times a day"}]},
{"fact": "0.19", "status": "stated", "evidence": [{"item": 1, "quote": "The motion of the fault generates numerous small earthquakes , at multiple times a day , most of which are too small to be felt"}]},
{"fact": "0.20", "status": "stated", "evidence": [{"item": 1, "quote": "The active Queen Charlotte Fault"}]},
{"fact": "0.21", "status": "stated", "evidence": [{"item": 1, "quote": "The active Queen Charlotte Fault on the west coast of the Haida Gwaii , British Columbia"}]},
{"fact": "0.22", "status": "stated", "evidence": [{"item": 1, "quote": "The active Queen Charlotte Fault on the west coast of the Haida Gwaii , British Columbia , has generated three large earthquakes during the 20th century"}]},
{"fact": "0.23", "status": "stated", "evidence": [{"item": 1, "quote": "a magnitude 7 event in 1929"}]},
{"fact": "0.24", "status": "stated", "evidence": [{"item": 1, "quote": "a magnitude 8.1 in 1949 ( Canada 's largest recorded earthquake )"}]},
{"fact": "0.25", "status": "stated", "evidence": [{"item": 1, "quote": "a magnitude 7.4 in 1970"}]}
]},
