   },
   {
    "fact": "0.1",
    "status": "missing",
    "evidence": []
   },
   {
    "fact": "0.2",
    "status": "stated",
    "evidence": [
     {
      "item": 5,
      "quote": "Irish pronunciation : ( ˈʃɪnjeːd̪ɣ ) or ( ʃɪˈnjeːd̪ɣ )"
     }
    ]
   },
   {
    "fact": "0.3",
    "status": "stated",
    "evidence": [
     {
      "item": 5,
      "quote": "It is derived from the French Jeanette"
     }
    ]
   },
   {
    "fact": "0.4",
    "status": "stated",
    "evidence": [
     {
      "item": 5,
      "quote": "which is cognate to the English Janet"
     }
    ]
   },
   {
    "fact": "0.5",
    "status": "stated",
    "evidence": [
     {
      "item": 5,
      "quote": "itself a feminine form of the Hebrew Yohannan"
     }
    ]
   },
   {
    "fact": "0.6",
    "status": "stated",
    "evidence": [
     {
      "item": 5,
      "quote": "the Hebrew Yohannan , `` God forgave / God gratified ''"
     }
    ]
   },
   {
    "fact": "0.7",
    "status": "stated",
    "evidence": [
     {
      "item": 5,
      "quote": "In English , Sinéad is also commonly spelled Sinead"
     }
    ]
   },
   {
    "fact": "0.8",
    "status": "stated",
    "evidence": [
     {
      "item": 5,
      "quote": "The name is generally translated into English as either Jane or Jennifer"
     }
    ]
   },
   {
    "fact": "0.9",
    "status": "stated",
    "evidence": [
     {
      "item": 5,
      "quote": "The name is generally translated into English as either Jane or Jennifer , or as the female version of the Scottish name Jean"
     }
    ]
   }
  ]
