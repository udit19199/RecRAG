      "quote": "Species : C. capillata"
     }
    ]
   },
   {
    "fact": "0.7",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "Binomial name Cyanea capillata"
     }
    ]
   },
   {
    "fact": "0.8",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "Binomial name Cyanea capillata ( Linnaeus , 1758 )"
     }
    ]
   },
   {
    "fact": "1.0",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "The lion 's mane jellyfish ( Cyanea capillata ) , also known as the giant jellyfish or the hair jelly"
     }
    ]
   },
   {
    "fact": "1.1",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "The lion 's mane jellyfish ( Cyanea capillata ) , also known as the giant jellyfish or the hair jelly , is the largest known species of jellyfish"
     }
    ]
   },
   {
    "fact": "1.2",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "is the largest known species of jellyfish . Its range is confined to cold , boreal waters of the Arctic , northern Atlantic , and northern Pacific Oceans"
     }
    ]
   },
   {
    "fact": "1.3",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "It is common in the English Channel , Irish Sea , North Sea and in western Scandinavian waters south to Kattegat and Øresund"
     }
    ]
   },
   {
    "fact": "1.4",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "It is common in the English Channel , Irish Sea , North Sea and in western Scandinavian waters south to Kattegat and Øresund"
     }
    ]
   },
   {
    "fact": "1.5",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "It may also drift in to the south - western part of the Baltic Sea"
     }
    ]
   },
   {
    "fact": "1.6",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "part of the Baltic Sea ( where it can not breed due to the low salinity"
     }
    ]
   },
   {
    "fact": "1.7",
    "status": "stated",
    "evidence": [
     {
      "item": 4,
      "quote": "Similar jellyfish -- which may be the same species -- are known to inhabit seas near Australia and New Zealand"
     }
    ]
   },
   {
    "fact": "1.8",
    "status": "stated",
    "evidence": [
     {
      "item": 1,
      "quote": "The largest recorded specimen found washed up on the shore of Massachusetts Bay in 1870"
     }
    ]
   },
   {
    "fact": "1.9",
    "status": "stated",
    "evidence": [
     {
      "item": 1,
      "quote": "The largest recorded specimen found washed up on the shore of Massachusetts Bay in 1870 , had a bell with a diameter of 2.3 metres ( 7 ft 6 in )"
     }
    ]
   },
   {
    "fact": "1.10",
    "status": "stated",
    "evidence": [
     {
      "item": 1,
      "quote": "had a bell with a diameter of 2.3 metres ( 7 ft 6 in ) and tentacles 37.0 m ( 121.4 ft ) long"
     }
    ]
   },
   {
    "fact": "1.11",
    "status": "stated",
    "evidence": [
     {
      "item": 1,
      "quote": "Lion 's mane jellyfish have been observed below 42 ° N latitude for some time"
     }
    ]
   },
   {
    "fact": "1.12",
    "status": "stated",
    "evidence": [
     {
      "item": 1,
      "quote": "have been observed below 42 ° N latitude for some time in the larger bays of the east coast of the United States"
     }
    ]
   }
  ]
