[
 {
  "id": "5eba6f223606cde7",
  "facts": [
   {
    "fact": "0.0",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "Transcription occurs in the cell nucleus , where the DNA is held ."
     }
    ]
   },
   {
    "fact": "0.1",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "Transcription occurs in the cell nucleus , where the DNA is held ."
     }
    ]
   },
   {
    "fact": "0.2",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "The DNA structure of the cell is made up of two helixes"
     }
    ]
   },
   {
    "fact": "0.3",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "two helixes made up of sugar and phosphate"
     }
    ]
   },
   {
    "fact": "0.4",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "held together by hydrogen bonds between the bases of opposite strands"
     }
    ]
   },
   {
    "fact": "0.5",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "The sugar and the phosphate in each strand are joined together by stronger phosphodiester covalent bonds"
     }
    ]
   },
   {
    "fact": "0.6",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "held together by hydrogen bonds between the bases of opposite strands . The sugar and the phosphate in each strand are joined together by stronger phosphodiester covalent bonds"
     }
    ]
   },
   {
    "fact": "0.7",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "The DNA is `` unzipped '' ( disruption of hydrogen bonds between different single strands ) by the enzyme helicase"
     }
    ]
   },
   {
    "fact": "0.8",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "`` unzipped '' ( disruption of hydrogen bonds between different single strands )"
     }
    ]
   },
   {
    "fact": "0.9",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "by the enzyme helicase , leaving the single nucleotide chain open to be copied"
     }
    ]
   },
   {
    "fact": "0.10",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "RNA polymerase reads the DNA strand from the 3 - prime ( 3 ' ) end to the 5 - prime ( 5 ' ) end"
     }
    ]
   },
   {
    "fact": "0.11",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "RNA polymerase reads the DNA strand from the 3 - prime ( 3 ' ) end to the 5 - prime ( 5 ' ) end , while it synthesizes a single strand of messenger RNA"
     }
    ]
   },
   {
    "fact": "0.12",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "while it synthesizes a single strand of messenger RNA in the 5 ' - to - 3 ' direction"
     }
    ]
   },
   {
    "fact": "0.13",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "The general RNA structure is very similar to the DNA structure"
     }
    ]
   },
   {
    "fact": "0.14",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "but in RNA the nucleotide uracil takes the place that thymine occupies in DNA"
     }
    ]
   },
   {
    "fact": "0.15",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "The single strand of mRNA leaves the nucleus through nuclear pores"
     }
    ]
   },
   {
    "fact": "0.16",
    "status": "stated",
    "evidence": [
     {
      "item": 8,
      "quote": "The single strand of mRNA leaves the nucleus through nuclear pores , and migrates into the cytoplasm"
     }
    ]
   }
  ]
 },
