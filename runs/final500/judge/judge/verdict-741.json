{"fact": "0.2", "status": "stated", "evidence": [{"item": 3, "quote": "is a salt lake bordered by Jordan to the east and Israel and Palestine to the west"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 3, "quote": "is a salt lake bordered by Jordan to the east and Israel and Palestine to the west"}]},
