{"fact": "0.2", "status": "stated", "evidence": [{"item": 5, "quote": "Most callable bonds allow the issuer to repay the bond at par"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 5, "quote": "With some bonds , the issuer has to pay a premium , the so - called call premium"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 5, "quote": "This is mainly the case for high - yield bonds"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 5, "quote": "These have very strict covenants , restricting the issuer in its operations"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 5, "quote": "To be free from these covenants , the issuer can repay the bonds early"}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 5, "quote": "the issuer can repay the bonds early , but only at a high cost"}]}
]},
