{"fact": "0.5", "status": "stated", "evidence": [{"item": 3, "quote": "Its surface and shores are 430.5 metres ( 1,412 ft ) below sea level"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 3, "quote": "Its surface and shores are 430.5 metres ( 1,412 ft ) below sea level , Earth 's lowest elevation on land"}]},
