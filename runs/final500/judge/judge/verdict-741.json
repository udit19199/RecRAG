{"fact": "0.9", "status": "stated", "evidence": [{"item": 5, "quote": "With a salinity of 342 g / kg , or 34.2 % , ( in 2011 )"}]},
{"fact": "0.10", "status": "stated", "evidence": [{"item": 5, "quote": "it is 9.6 times as salty as the ocean"}]},
{"fact": "0.11", "status": "stated", "evidence": [{"item": 5, "quote": "one of the world 's saltiest bodies of water"}]},
{"fact": "0.12", "status": "stated", "evidence": [{"item": 5, "quote": "This salinity makes for a harsh environment in which plants and animals can not flourish"}]},
{"fact": "0.13", "status": "stated", "evidence": [{"item": 5, "quote": "This salinity makes for a harsh environment in which plants and animals can not flourish , hence its name"}]},
{"fact": "0.14", "status": "stated", "evidence": [{"item": 5, "quote": "The Dead Sea is 50 kilometres ( 31 mi ) long"}]},
{"fact": "0.15", "status": "stated", "evidence": [{"item": 5, "quote": "15 kilometres ( 9 mi ) wide at its widest point"}]},
