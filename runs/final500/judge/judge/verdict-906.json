{"id": "440aeb4174353054", "facts": [
{"fact": "0.0", "status": "stated", "evidence": [{"item": 3, "quote": "is the capital of the People 's Republic of China"}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 3, "quote": "formerly romanized as Peking"}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 3, "quote": "the world 's second most populous city proper , and most populous capital city"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 3, "quote": "the world 's second most populous city proper , and most populous capital city"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 3, "quote": "The city , located in northern China , is governed as a direct - controlled municipality under the national government with 16 urban , suburban , and rural districts"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 3, "quote": "The city , located in northern China , is governed as a direct - controlled municipality under the national government with 16 urban , suburban , and rural districts"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 3, "quote": "The city , located in northern China , is governed as a direct - controlled municipality under the national government with 16 urban , suburban , and rural districts"}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 3, "quote": "Beijing Municipality is surrounded by Hebei Province with the exception of neighboring Tianjin Municipality to the southeast ; together the three divisions form the Jingjinji metropolitan region and the national capital region of China"}]},
{"fact": "0.8", "status": "stated", "evidence": [{"item": 3, "quote": "Beijing Municipality is surrounded by Hebei Province with the exception of neighboring Tianjin Municipality to the southeast ; together the three divisions form the Jingjinji metropolitan region and the national capital region of China"}]},
{"fact": "0.9", "status": "stated", "evidence": [{"item": 3, "quote": "Beijing Municipality is surrounded by Hebei Province with the exception of neighboring Tianjin Municipality to the southeast ; together the three divisions form the Jingjinji metropolitan region and the national capital region of China"}]},
{"fact": "1.0", "status": "stated", "evidence": [{"item": 6, "quote": "Over the past 3,000 years , the city of Beijing has had numerous other names"}]},
{"fact": "1.1", "status": "stated", "evidence": [{"item": 2, "quote": "The name Beijing , which means `` Northern Capital ''"}]},
{"fact": "1.2", "status": "stated", "evidence": [{"item": 2, "quote": "The name Beijing , which means `` Northern Capital '' ( from the Chinese characters 北 for north and 京 for capital )"}]},
{"fact": "1.3", "status": "stated", "evidence": [{"item": 2, "quote": "was applied to the city in 1403 during the Ming dynasty to distinguish the city from Nanjing ( the `` Southern Capital '' )"}]},
{"fact": "1.4", "status": "stated", "evidence": [{"item": 2, "quote": "was applied to the city in 1403 during the Ming dynasty to distinguish the city from Nanjing ( the `` Southern Capital '' )"}]},
{"fact": "1.5", "status": "stated", "evidence": [{"item": 2, "quote": "The English spelling is based on the pinyin romanization of the two characters as they are pronounced in Standard Mandarin"}]},
{"fact": "1.6", "status": "stated", "evidence": [{"item": 2, "quote": "An older English spelling , Peking , is the postal romanization of the same two characters as they are pronounced in Chinese dialects spoken in the southern port towns"}]},
{"fact": "1.7", "status": "stated", "evidence": [{"item": 2, "quote": "in Chinese dialects spoken in the southern port towns first visited by European traders and missionaries"}]},
{"fact": "1.8", "status": "stated", "evidence": [{"item": 2, "quote": "Chinese dialects spoken in the southern port towns first visited by European traders and missionaries . Those dialects preserve the Middle Chinese pronunciation of 京 as kjaeng"}]},
{"fact": "1.9", "status": "stated", "evidence": [{"item": 2, "quote": "Those dialects preserve the Middle Chinese pronunciation of 京 as kjaeng , prior to a phonetic shift in the northern dialects to the modern pronunciation"}]},
{"fact": "1.10", "status": "stated", "evidence": [{"item": 2, "quote": "Although Peking is no longer the common name for the city"}]},
{"fact": "1.11", "status": "stated", "evidence": [{"item": 2, "quote": "some of the city 's older locations and facilities , such as Beijing Capital International Airport , with IATA Code PEK , and Peking University , still use the former romanization"}]},
{"fact": "1.12", "status": "stated", "evidence": [{"item": 2, "quote": "some of the city 's older locations and facilities , such as Beijing Capital International Airport , with IATA Code PEK , and Peking University , still use the former romanization"}]},
{"fact": "1.13", "status": "stated", "evidence": [{"item": 2, "quote": "some of the city 's older locations and facilities , such as Beijing Capital International Airport , with IATA Code PEK , and Peking University , still use the former romanization"}]}
]},
