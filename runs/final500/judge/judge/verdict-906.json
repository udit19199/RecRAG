{"fact": "0.9", "status": "stated", "evidence": [{"item": 6, "quote": "and about 20 -- 25 % achieve a ' C ' grade"}]},
{"fact": "0.10", "status": "stated", "evidence": [{"item": 6, "quote": "The National Senior Certificate is a group certificate and records an aggregate mark"}]},
