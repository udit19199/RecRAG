{"fact": "0.2", "status": "stated", "evidence": [{"item": 5, "quote": "After being held intermittently since 1894 , the Carnaval de Québec has been celebrated annually since 1955"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 5, "quote": "the Carnaval de Québec has been celebrated annually since 1955"}]},
