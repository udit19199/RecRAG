{"id": "7fc686941afa7e21", "facts": [
{"fact": "0.0", "status": "stated", "evidence": [{"item": 8, "quote": "An elevator with a counterbalance approximates an ideal Atwood machine"}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 8, "quote": "and thereby relieves the driving motor from the load of holding the elevator cab"}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 8, "quote": "relieves the driving motor from the load of holding the elevator cab -- it has to overcome only weight difference and inertia of the two masses"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 8, "quote": "The same principle is used for funicular railways with two connected railway cars on inclined tracks"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 8, "quote": "The same principle is used for funicular railways with two connected railway cars on inclined tracks , and for the elevators on the Eiffel Tower which counterbalance each other"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 8, "quote": "Ski lifts are another example"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 8, "quote": "where the gondolas move on a closed ( continuous ) pulley system up and down the mountain"}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 8, "quote": "The ski lift is similar to the counter-weighted elevator , but with a constraining force provided by the cable in the vertical dimension"}]},
{"fact": "0.8", "status": "stated", "evidence": [{"item": 8, "quote": "thereby achieving work in both the horizontal and vertical dimensions"}]},
{"fact": "0.9", "status": "stated", "evidence": [{"item": 4, "quote": "Boat lifts are another type of counter-weighted elevator system approximating an Atwood machine"}]}
]},
