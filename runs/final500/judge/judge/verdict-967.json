{"id": "318df246095ee282", "facts": [
{"fact": "0.0", "status": "stated", "evidence": [{"item": 10, "quote": "In 1910 , in conjunction with advocacy work led by Florence Kelley of the National Consumer League , the Women 's Trade Union League ( WTLU ) of Massachusetts under the leadership of Elizabeth Evans took up the cause of minimum wage legislation in Massachusetts"}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 10, "quote": "In 1910 , in conjunction with advocacy work led by Florence Kelley of the National Consumer League"}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 10, "quote": "Over the next two years , a coalition of social reform groups and labor advocates in Boston pushed for minimum wage legislation in the state"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 10, "quote": "In 1912 , Massachusetts passed the first American minimum wage legislation"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 10, "quote": "In 1912 , Massachusetts passed the first American minimum wage legislation , which established a state commission for recommending non-compulsory minimum wages for women and children"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 10, "quote": "Within eight years , at least thirteen U.S. states and the District of Columbia would pass minimum wage laws"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 10, "quote": "with pressure being placed on state legislatures by the National Consumers League in a coalition with other women 's voluntary associations and organized labor"}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 10, "quote": "The United States Supreme Court of the Lochner era consistently invalidated compulsory minimum wage laws"}]},
{"fact": "0.8", "status": "stated", "evidence": [{"item": 10, "quote": "Advocates for these minimum wage laws hoped that they would be upheld under the precedent of Muller v. Oregon"}]},
{"fact": "0.9", "status": "stated", "evidence": [{"item": 10, "quote": "Muller v. Oregon , which upheld maximum working hours laws for women on the grounds that women required special protection that men did not"}]},
{"fact": "0.10", "status": "stated", "evidence": [{"item": 8, "quote": "However , the Court did not extend this principle to minimum wage laws , considering the latter as interfering with the ability of employers to freely negotiate wage contracts with employees"}, {"item": 10, "quote": "Muller v. Oregon , which upheld maximum working hours laws for women on the grounds that women required special protection that men did not"}]},
{"fact": "0.11", "status": "stated", "evidence": [{"item": 8, "quote": "However , the Court did not extend this principle to minimum wage laws , considering the latter as interfering with the ability of employers to freely negotiate wage contracts with employees"}]},
{"fact": "1.0", "status": "stated", "evidence": [{"item": 8, "quote": "In 1933 , the Roosevelt administration made the first attempt at establishing a national minimum wage"}]},
{"fact": "1.1", "status": "stated", "evidence": [{"item": 8, "quote": "In 1933 , the Roosevelt administration made the first attempt at establishing a national minimum wage , when a $0.25 per hour standard was set as part of the National Industrial Recovery Act"}]},
{"fact": "1.2", "status": "stated", "evidence": [{"item": 8, "quote": "standard was set as part of the National Industrial Recovery Act . However , in the 1935 court case Schechter Poultry Corp. v. United States ( 295 U.S. 495 ) , the US Supreme Court declared the act unconstitutional"}]},
{"fact": "1.3", "status": "stated", "evidence": [{"item": 8, "quote": "However , in the 1935 court case Schechter Poultry Corp. v. United States ( 295 U.S. 495 ) , the US Supreme Court declared the act unconstitutional , and the minimum wage was abolished"}]},
{"fact": "1.4", "status": "stated", "evidence": [{"item": 8, "quote": "In 1938 , the minimum wage was re-established pursuant to the Fair Labor Standards Act"}]},
{"fact": "1.5", "status": "stated", "evidence": [{"item": 8, "quote": "In 1938 , the minimum wage was re-established pursuant to the Fair Labor Standards Act , once again at $0.25 per hour"}]},
{"fact": "1.6", "status": "stated", "evidence": [{"item": 8, "quote": "once again at $0.25 per hour ( $4.78 in 2017 dollars )"}]},
{"fact": "1.7", "status": "stated", "evidence": [{"item": 8, "quote": "In 1941 , the Supreme Court upheld the Fair Labor Standards Act in United States v. Darby Lumber Co."}]},
{"fact": "1.8", "status": "stated", "evidence": [{"item": 8, "quote": "in United States v. Darby Lumber Co. , holding that Congress had the power under the Commerce Clause to regulate employment conditions"}]}
]},
