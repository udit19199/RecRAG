 {
  "id": "8e009a7087d743f2",
  "facts": [
   {
    "fact": "0.0",
    "status": "stated",
    "evidence": [
     {
      "item": 6,
      "quote": "Somatic motor neurons originate in the central nervous system"
     }
    ]
   },
   {
    "fact": "0.1",
    "status": "stated",
    "evidence": [
     {
      "item": 6,
      "quote": "project their axons to skeletal muscles"
     }
    ]
   },
   {
    "fact": "0.2",
    "status": "stated",
    "evidence": [
     {
      "item": 6,
      "quote": "such as the muscles of the limbs , abdominal , and intercostal muscles"
     }
    ]
   },
   {
    "fact": "0.3",
    "status": "stated",
    "evidence": [
     {
      "item": 6,
      "quote": "which are involved in locomotion"
     }
    ]
   },
   {
    "fact": "0.4",
    "status": "stated",
    "evidence": [
     {
      "item": 6,
      "quote": "The three types of these neurons are the alpha efferent neurons , beta efferent neurons , and gamma efferent neurons"
     }
    ]
   },
   {
    "fact": "0.5",
    "status": "stated",
    "evidence": [
     {
      "item": 6,
      "quote": "The three types of these neurons are the alpha efferent neurons , beta efferent neurons , and gamma efferent neurons"
     }
    ]
   },
   {
    "fact": "0.6",
    "status": "stated",
    "evidence": [
     {
      "item": 6,
      "quote": "They are called efferent to indicate the flow of information from the central nervous system ( CNS ) to the periphery"
     }
    ]
   },
   {
    "fact": "0.7",
    "status": "stated",
    "evidence": [
     {
      "item": 6,
      "quote": "They are called efferent to indicate the flow of information from the central nervous system ( CNS ) to the periphery"
     }
    ]
   },
   {
    "fact": "1.0",
    "status": "stated",
    "evidence": [
     {
      "item": 2,
      "quote": "The term ' motor neuron ' is usually restricted to the lower motor neurons"
     }
    ]
   },
   {
    "fact": "1.1",
    "status": "stated",
    "evidence": [
     {
      "item": 2,
      "quote": "restricted to the lower motor neurons , the efferent nerves that directly innervate muscles"
     }
    ]
   }
  ]
