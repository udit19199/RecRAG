{"id": "39e0959eec4988d2", "facts": [
{"fact": "0.0", "status": "stated", "evidence": [{"item": 4, "quote": "Fortnite is set in contemporary Earth"}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 4, "quote": "the sudden appearance of a worldwide storm causes 98 % of the world 's population to disappear"}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 4, "quote": "zombie - like creatures rise to attack the remainder"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 5, "quote": "Considered by Epic as a cross between Minecraft and Left 4 Dead"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 5, "quote": "Fortnite has up to four players cooperating on various missions"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 5, "quote": "on various missions on randomly - generated maps"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 5, "quote": "on various missions on randomly - generated maps to collect resources"}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 5, "quote": "build fortifications around defensive objectives"}]},
{"fact": "0.8", "status": "stated", "evidence": [{"item": 5, "quote": "build fortifications around defensive objectives that are meant to help fight the storm and protect survivors"}]},
{"fact": "0.9", "status": "stated", "evidence": [{"item": 5, "quote": "and construct weapons and traps to engage in combat"}]},
{"fact": "0.10", "status": "stated", "evidence": [{"item": 5, "quote": "to engage in combat with waves of these creatures"}, {"item": 4, "quote": "zombie - like creatures rise to attack the remainder"}]},
{"fact": "0.11", "status": "stated", "evidence": [{"item": 5, "quote": "these creatures that attempt to destroy the objectives"}]},
{"fact": "0.12", "status": "stated", "evidence": [{"item": 5, "quote": "Players gain rewards through these missions"}]},
{"fact": "0.13", "status": "stated", "evidence": [{"item": 5, "quote": "Players gain rewards through these missions to improve their hero characters , support teams , and arsenal of weapon and trap schematics"}]},
{"fact": "0.14", "status": "stated", "evidence": [{"item": 5, "quote": "to be able to take on more difficult missions"}]},
{"fact": "0.15", "status": "stated", "evidence": [{"item": 5, "quote": "The game is supported through microtransactions to purchase in - game currency"}]},
{"fact": "0.16", "status": "stated", "evidence": [{"item": 5, "quote": "microtransactions to purchase in - game currency that can be used towards these upgrades"}]},
{"fact": "0.17", "status": "stated", "evidence": [{"item": 5, "quote": "currency that can be used towards these upgrades"}]},
{"fact": "1.0", "status": "stated", "evidence": [{"item": 7, "quote": "Fortnite was first revealed at the 2011 Spike Video Game Awards ( VGA )"}]},
{"fact": "1.1", "status": "stated", "evidence": [{"item": 7, "quote": "Fortnite was first revealed at the 2011 Spike Video Game Awards ( VGA ) , with Epic 's former design director Cliff Bleszinski introducing a trailer for the game"}]},
{"fact": "1.2", "status": "stated", "evidence": [{"item": 7, "quote": "Donald Mustard , creative lead at Epic , said in 2017 that this announcement was `` three weeks after we came up with the idea , before we even made the game"}]},
{"fact": "1.3", "status": "stated", "evidence": [{"item": 7, "quote": "The title , which started out as an internal game jam project"}]},
{"fact": "1.4", "status": "stated", "evidence": [{"item": 7, "quote": "represents a departure from the company 's previous work"}]},
{"fact": "1.5", "status": "stated", "evidence": [{"item": 7, "quote": "Epic wanted to `` switch things up a little bit and do something different and fun '' with Fortnite"}]},
{"fact": "1.6", "status": "stated", "evidence": [{"item": 7, "quote": "describing it as `` a world where you explore , you scavenge , you build and ultimately you survive"}]},
{"fact": "1.7", "status": "stated", "evidence": [{"item": 7, "quote": "In an interview with Engadget , he also echoed these statements , claiming that the game would be different from the Gears of War series"}]},
{"fact": "1.8", "status": "stated", "evidence": [{"item": 7, "quote": "There 's no dudebros in it"}]},
{"fact": "1.9", "status": "stated", "evidence": [{"item": 7, "quote": "But creatively for the team , Gears has been amazing for us"}]},
{"fact": "1.10", "status": "stated", "evidence": [{"item": 7, "quote": "But it 's fun to kind of stretch our wings and do something that 's a little different from the usual"}]},
{"fact": "1.11", "status": "stated", "evidence": [{"item": 10, "quote": "Epic Games Vice President of Publishing Mike Fischer said in 2015 that Epic recognized that they `` announced this game too soon ''"}]},
{"fact": "1.12", "status": "stated", "evidence": [{"item": 10, "quote": "Epic Games Vice President of Publishing Mike Fischer said in 2015 that Epic recognized that they `` announced this game too soon '' , and that its lengthy development period was due to `` very good reasons"}]}
]},
