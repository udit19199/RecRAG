{"id": "378246a7815dae0d", "facts": [
{"fact": "0.0", "status": "stated", "evidence": [{"item": 5, "quote": "The soma ( cell body ) of each pseudounipolar neuron is located within a dorsal root ganglion"}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 5, "quote": "The axon leaves the cell body"}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 5, "quote": "The axon leaves the cell body ( and out of the dorsal root ganglion )"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 5, "quote": "The axon leaves the cell body ( and out of the dorsal root ganglion ) into the dorsal root"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 5, "quote": "The axon leaves the cell body ( and out of the dorsal root ganglion ) into the dorsal root , where it splits into two branches"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 5, "quote": "The central branch goes to the posterior ( dorsal ) horn of the spinal cord"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 5, "quote": "The central branch goes to the posterior ( dorsal ) horn of the spinal cord , where it forms synapses with other neurons"}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 5, "quote": "The peripheral branch travels through the distal dorsal root"}]},
{"fact": "0.8", "status": "stated", "evidence": [{"item": 5, "quote": "The peripheral branch travels through the distal dorsal root into the spinal nerve"}]},
{"fact": "0.9", "status": "stated", "evidence": [{"item": 5, "quote": "The peripheral branch travels through the distal dorsal root into the spinal nerve all the way until skin , joint , and muscle"}]}
]},
