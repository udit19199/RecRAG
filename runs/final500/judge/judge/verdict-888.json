{"fact": "1.2", "status": "stated", "evidence": [{"item": 5, "quote": "called upon to shoot an aggressive elephant"}]},
{"fact": "1.3", "status": "stated", "evidence": [{"item": 5, "quote": "called upon to shoot an aggressive elephant while working as a police officer in Burma"}]},
{"fact": "1.4", "status": "stated", "evidence": [{"item": 2, "quote": "due to their expectation , he realises that he must shoot the elephant"}]},
