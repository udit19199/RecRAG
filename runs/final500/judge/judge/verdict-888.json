{"fact": "0.0", "status": "stated", "evidence": [{"item": 7, "quote": "Whistleblower Protection Act of 1989 , Pub. L. 101 - 12 as amended"}]},
{"fact": "0.1", "status": "stated", "evidence": [{"item": 7, "quote": "is a United States federal law that protects federal whistleblowers"}]},
{"fact": "0.2", "status": "stated", "evidence": [{"item": 7, "quote": "protects federal whistleblowers who work for the government and report agency misconduct"}]},
{"fact": "0.3", "status": "stated", "evidence": [{"item": 7, "quote": "A federal agency violates the Whistleblower Protection Act if agency authorities take ( or threaten to take ) retaliatory personnel action against any employee or applicant"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 7, "quote": "retaliatory personnel action against any employee or applicant because of disclosure of information by that employee or applicant"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 7, "quote": "Whistleblowers may file complaints that they believe reasonably evidences a violation of a law , rule or regulation"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 7, "quote": "Whistleblowers may file complaints that they believe reasonably evidences a violation of a law , rule or regulation ; gross mismanagement"}]},
{"fact": "0.7", "status": "stated", "evidence": [{"item": 7, "quote": "Whistleblowers may file complaints that they believe reasonably evidences a violation of a law , rule or regulation ; gross mismanagement ; gross waste of funds"}]},
{"fact": "0.8", "status": "stated", "evidence": [{"item": 7, "quote": "Whistleblowers may file complaints that they believe reasonably evidences a violation of a law , rule or regulation ; gross mismanagement ; gross waste of funds ; an abuse of authority"}]},
{"fact": "0.9", "status": "stated", "evidence": [{"item": 7, "quote": "Whistleblowers may file complaints that they believe reasonably evidences a violation of a law , rule or regulation ; gross mismanagement ; gross waste of funds ; an abuse of authority ; or a substantial and specific danger to public health or safety"}]}
