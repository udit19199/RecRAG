{"fact": "0.3", "status": "stated", "evidence": [{"item": 9, "quote": "is a police officer during a period of intense anti-European sentiment"}]},
{"fact": "0.4", "status": "stated", "evidence": [{"item": 9, "quote": "Although his intellectual sympathies lie with the Burmese"}]},
{"fact": "0.5", "status": "stated", "evidence": [{"item": 9, "quote": "his official role makes him a symbol of the oppressive imperial power"}]},
{"fact": "0.6", "status": "stated", "evidence": [{"item": 9, "quote": "he is subjected to constant baiting and jeering by the local people"}]},
