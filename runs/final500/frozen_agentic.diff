+def _graph_facts(value: Any) -> Any:
+    """Drop passage text and keep at most CYPHER_LIST_LIMIT items per list."""
+    if isinstance(value, dict):
+        return {
+            key: _graph_facts(item)
+            for key, item in value.items()
