# RecRAG Environment Variables
# Copy this file to .env and fill in your API keys
# ONLY sensitive information goes here - everything else is in config.toml


# ── Ollama (First-Class Citizen — No Keys Needed for Local) ──────────────────
# Override the Ollama host for all providers (embedding, LLM, vision).
# Default: http://localhost:11434
# Per-provider overrides available via base_url in config.toml.
# OLLAMA_HOST=http://192.168.1.100:11434

# ── OpenAI (Required if using OpenAI provider) ───────────────────────────────
# OPENAI_API_KEY=sk-your-openai-api-key-here
#
# ── LM Studio (local embedding via OpenAI-compatible API) ────────────────────
# Set embedding.provider = "lmstudio" in config.toml (default base URL :1234/v1).
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ── Google Gemini (Free tier available) ──────────────────────────────────────
# Get one at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# ── NVIDIA NIM (Required if using NIM provider) ─────────────────────────────
# Starts with "nvapi-"
# NVIDIA_API_KEY=nvapi-your-key-here

# ── LlamaCloud (Needed for LlamaParseLoader in dev mode) ────────────────────
# Get one at: https://cloud.llamaindex.ai
# LLAMA_CLOUD_API_KEY=

# ── Milvus Cloud Credentials (if using managed/cloud Milvus) ────────────────
# MILVUS_HOST=your-managed-instance.cloud.zilliz.com
# MILVUS_USERNAME=
# MILVUS_PASSWORD=

# ── Kubernetes Deployment ─────────────────────────────────────────────────────
# These are baked into the frontend bundle at build time.
# For K8s, set these to your ingress hostnames before building.
# NEXT_PUBLIC_RETRIEVAL_API_URL=https://retrieval.recrag.example.com
# NEXT_PUBLIC_INGESTION_API_URL=https://ingestion.recrag.example.com
# NEXT_PUBLIC_ORCHESTRATOR_API_URL=https://orchestrator.recrag.example.com

# ── Orchestrator / Postgres (D27) ─────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/recrag
# Default dev: sqlite at state/orchestrator.db
# RETRIEVAL_API_URL=http://127.0.0.1:8000
# INGESTION_API_URL=http://127.0.0.1:8001

# ── App auth (internal research) ──────────────────────────────────────────────
# When RECRAG_AUTH_SECRET is set, the UI and orchestrator require sign-in.
# Leave empty to disable auth (local development).
# RECRAG_AUTH_SECRET=use-a-long-random-string-at-least-32-chars
# RECRAG_AUTH_USERNAME=research
# RECRAG_AUTH_PASSWORD=research

# ── Dev Mode ──────────────────────────────────────────────────────────────────
# Set RECRAG_DEV=1 to enable:
#   - Shared Milvus Lite (single embedded server shared across services)
#   - LlamaParse document parsing (requires LLAMA_CLOUD_API_KEY)
RECRAG_DEV=1
