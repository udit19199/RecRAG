# RecRAG Environment Variables
# Copy this file to .env and fill in your API keys
# ONLY sensitive information goes here - everything else is in config.toml

# API Authentication (set to enable API key auth on all endpoints)
# Leave empty to disable authentication (development only)
REC_RAG_API_KEY=your-secret-api-key-here

# OpenAI API Key (required if using OpenAI provider)
OPENAI_API_KEY=***

# NVIDIA API Key (required if using NVIDIA NIM provider, starts with "nvapi-")
NVIDIA_API_KEY=nvapi-your-key-here

# Ollama API Key (required if using Ollama Cloud API at https://ollama.com)
# Generate one at: https://ollama.com/settings/keys
OLLAMA_API_KEY=your-ollama-api-key-here

# Milvus Cloud Credentials (if using managed/cloud Milvus)
MILVUS_HOST=your-managed-instance.cloud.zilliz.com
MILVUS_USERNAME=
MILVUS_PASSWORD=

# Kubernetes deployment: set NEXT_PUBLIC_* URLs
# These are baked into the frontend bundle at build time.
# For local dev, the docker-compose defaults work fine.
# For K8s, set these to your ingress hostnames before building.
# NEXT_PUBLIC_RETRIEVAL_API_URL=https://retrieval.recrag.example.com
# NEXT_PUBLIC_INGESTION_API_URL=https://ingestion.recrag.example.com
